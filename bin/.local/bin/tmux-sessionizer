#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$( { find -L ~/ -mindepth 1 -maxdepth 1 -type d; \
                  find -L ~/hexdev -mindepth 1 -maxdepth 1 -type d 2>/dev/null; \
                  find -L ~/Projects -mindepth 1 -maxdepth 1 -type d 2>/dev/null; } | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)

setup_env() {
    local session=$1
    local dir=$2

    if [[ $dir == "$HOME/hexdev"* ]]; then
        tmux send-keys -t "$session" "source ~/hexdev/mlir-env/bin/activate" C-m

        if [[ -f "$HOME/.local/bin/hexdev-set-var.sh" ]]; then
            tmux send-keys -t "$session" "source ~/.local/bin/hexdev-set-var.sh" C-m
        fi
    fi
    tmux send-keys -t "$session" "clear" C-m
}

# `-t=` forces an exact match; without the `=`, tmux prefix-matches and
# "hexdev" would find an existing "hexdev-old". Also exits non-zero when
# no server is running at all, so there's no need to check for one first.
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -d -s "$selected_name" -c "$selected"
    setup_env "$selected_name" "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
